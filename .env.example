# EXAI-ResumeIntel: Environment configuration template
# Copy this file to .env and fill in the values for your deployment.
# Author: Mithin Sagar S

# ─── API server ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8765
API_LOG_LEVEL=info
API_RELOAD=false

# ─── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:8501,https://mithinsagar.github.io

# ─── Model paths ───────────────────────────────────────────────────
EMBEDDING_MODEL_PATH=models/embedding_engine.pkl
JOB_DF_PATH=models/job_df.pkl
JOB_EMBEDDINGS_PATH=models/job_embeddings.memmap

# ─── Data paths ────────────────────────────────────────────────────
RESUME_CORPUS_PATH=data/raw/clean_resume_data.csv
JOB_POSTINGS_PATH=data/raw/jobs_dataset_with_features.csv

# ─── Hugging Face ──────────────────────────────────────────────────
HF_DATA_REPO=mithinsagar/exai-resumeintel-data
HF_MODEL_REPO=mithinsagar/exai-resumeintel-models
HF_TOKEN=

# ─── SBERT model (Streamlit app) ───────────────────────────────────
SBERT_MODEL_NAME=sentence-transformers/all-mpnet-base-v2

# ─── Streamlit ─────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ─── History storage ───────────────────────────────────────────────
HISTORY_DB_PATH=data/processed/analysis_history.db
