# EXAI-ResumeIntel: Streamlit application Docker image
# Author: Mithin Sagar S
# GitHub: https://github.com/mithinsagar

FROM python:3.11-slim

LABEL org.opencontainers.image.title="EXAI-ResumeIntel Streamlit"
LABEL org.opencontainers.image.authors="Mithin Sagar S <mithinsagar@gmail.com>"
LABEL org.opencontainers.image.source="https://github.com/mithinsagar/EXAI-ResumeIntel"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy Streamlit app + minimum required core
COPY app/ ./app/
COPY core/ ./core/
COPY xai/ ./xai/
COPY config/ ./config/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl --fail http://localhost:8501/_stcore/health || exit 1

RUN useradd --create-home --shell /bin/bash exai && chown -R exai:exai /app
USER exai

CMD ["streamlit", "run", "app/main.py", \
     "--server.port=8501", "--server.address=0.0.0.0"]
